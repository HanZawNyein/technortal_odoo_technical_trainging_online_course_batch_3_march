<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="rosca_payout_line_view_form" model="ir.ui.view">
        <field name="name">rosca_payout_line_view_form</field>
        <field name="model">rosca.payout.line</field>
        <field name="arch" type="xml">
            <form string="rosca_payout_line_form" duplicate="0" create="0" delete="0">
                <header>
                    <button name="action_paid" type="object" class="btn btn-primary" string="Paid"
                            invisible="1"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="line_id"/>
                            <field name="group_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="dest_partner_id"/>
                            <field name="company_id" optional="hide"/>
                            <field name="currency_id" optional="hide"/>
                            <field name="payout_date" optional="show"/>
                        </group>
                        <group>
                            <field name="amount" sum="Total"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="rasoca_payout_line_view_list" model="ir.ui.view">
        <field name="name">rasoca_payout_line_view_list_view_list</field>
        <field name="model">rosca.payout.line</field>
        <field name="arch" type="xml">
            <list string="rasoca_payout_line_view_list_list" create="0" delete="0">
                <field name="name"/>
                <field name="line_id"/>
                <field name="group_id"/>
                <field name="partner_id"/>
                <field name="dest_partner_id"/>
                <field name="company_id" optional="hide"/>
                <field name="currency_id" optional="hide"/>
                <field name="payout_date" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'"
                       decoration-success="state == 'paid'"
                       decoration-warning="state == 'unpaid'"
                       decoration-danger="state == 'late'"/>
                <field name="amount" sum="Total"/>
                <button name="action_paid" type="object" class="btn btn-primary" string="Paid" invisible="is_paid"/>
            </list>
        </field>
    </record>

    <record id="rosca_payout_line_action" model="ir.actions.act_window">
        <field name="name">Payouts</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">rosca.payout.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>